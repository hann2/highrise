{
  "name": "highrise",
  "version": "0.0.1",
  "productName": "Highrise",
  "description": "A zombie shooter",
  "repository": "github:hann2/highrise",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "concurrently -n assets,server,editor \"npm run watch-manifest\" \"npm run dev-server\" \"npm run character-editor\"",
    "build": "vite build",
    "deploy": "npx vercel",
    "deploy-prod": "npx vercel --prod",
    "tsc": "tsc --noEmit",
    "tsc-watch": "tsc --noEmit --watch",
    "prettier": "prettier --write src",
    "dev-server": "vite",
    "character-editor": "tsx bin/character-editor/server.ts",
    "test": "playwright test",
    "benchmark": "BENCHMARK=1 playwright test",
    "generate-manifest": "tsx ./bin/generate-manifest.ts",
    "watch-manifest": "tsx ./bin/generate-manifest.ts watch",
    "test:physics": "tsx --test tests/physics/*.test.ts",
    "test:vision": "tsx --test tests/vision/*.test.ts",
    "test:characters": "tsx --test tests/characters/*.test.ts",
    "clip": "tsx bin/record-clip.ts",
    "preview": "vite preview --port 4173",
    "electron": "electron-forge start --",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test:electron": "electron-forge package && playwright test --config tests/electron/playwright.config.ts"
  },
  "author": "Philip Hann, Simon Baumgardt-Wellander",
  "license": "MIT",
  "dependencies": {
    "@pixi/tilemap": "^5.0.2",
    "pixi.js": "^8.21.0",
    "poly-decomp-es": "^0.4.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "camelcase": "^8.0.0",
    "chokidar": "^4.0.3",
    "concurrently": "^10.0.5",
    "electron": "^44.5.0",
    "ffmpeg-static": "^5.3.0",
    "glob": "^11.1.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
