{
  "name": "highrise",
  "version": "0.0.1",
  "description": "A zombie shooter",
  "repository": "github:hann2/highrise",
  "scripts": {
    "start": "rm -rf .parcel-cache && concurrently -n assets,server \"npm run watch-manifest\" \"npm run dev-server\"",
    "build": "parcel build src/index.html",
    "deploy": "npx vercel",
    "deploy-prod": "npx vercel --prod",
    "tsc": "tsc --noEmit",
    "tsc-watch": "tsc --noEmit --watch",
    "prettier": "prettier --write src",
    "dev-server": "parcel --no-hmr src/index.html",
    "test": "playwright test",
    "benchmark": "BENCHMARK=1 playwright test",
    "generate-manifest": "tsx ./bin/generate-manifest.ts",
    "watch-manifest": "tsx ./bin/generate-manifest.ts watch",
    "test:physics": "tsx --test tests/physics/*.test.ts"
  },
  "author": "Philip Hann, Simon Baumgardt-Wellander",
  "license": "MIT",
  "dependencies": {
    "@pixi/tilemap": "^5.0.2",
    "pixi.js": "^8.21.0",
    "poly-decomp-es": "^0.4.2"
  },
  "devDependencies": {
    "@parcel/transformer-glsl": "^2.16.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "camelcase": "^8.0.0",
    "chokidar": "^4.0.3",
    "concurrently": "^10.0.5",
    "glob": "^11.1.0",
    "parcel": "^2.16.4",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "url": "^0.11.4"
  },
  "browserslist": "last 2 Chrome versions, last 2 Firefox versions, last 2 Safari versions"
}
